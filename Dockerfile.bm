FROM node:24.14.0-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4173
ENV BM_MODULE_BASE=/modules/gods-eye/

COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts

COPY . .

EXPOSE 4173

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4173)+'/__bm_health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["npm","run","start:bm"]
